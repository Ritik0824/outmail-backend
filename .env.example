NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://outmail:outmail@localhost:5432/outmail
REDIS_URL=redis://localhost:6379

APP_ORIGINS=http://localhost:8080
FRONTEND_URL=http://localhost:8080
JWT_SECRET=replace-with-at-least-32-random-characters
SECRET_KEY=replace-with-an-independent-32-character-secret

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-with-access-key
AWS_SECRET_ACCESS_KEY=replace-with-secret-key
S3_BUCKET=replace-with-bucket-name
S3_URL=https://replace-with-bucket-name.s3.us-east-1.amazonaws.com
# S3_ENDPOINT=http://localhost:9000

# Comma-separated user emails allowed to open /admin/queues.
QUEUE_ADMIN_EMAILS=
