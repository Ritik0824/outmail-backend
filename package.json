{
  "name": "outmail-backend",
  "version": "1.0.0",
  "description": "Backend service for OutMail - Email automation platform",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "start:api": "node server.js",
    "start:worker": "node worker.js",
    "dev": "nodemon server.js",
    "dev:worker": "nodemon worker.js",
    "check": "node --check app.js && node --check server.js && node --check worker.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.842.0",
    "@bull-board/api": "^5.9.1",
    "@bull-board/express": "^5.9.1",
    "@bull-board/ui": "^5.9.1",
    "@prisma/client": "^6.10.1",
    "bullmq": "^5.56.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "8.3.0",
    "ioredis": "^5.6.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "2.2.0",
    "nodemailer": "9.0.5",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "prisma": "^6.10.1",
    "read-excel-file": "9.3.8",
    "redis": "^5.5.6"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
